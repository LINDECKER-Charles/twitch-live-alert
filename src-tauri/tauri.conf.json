{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twitch Live Alert",
  "version": "0.3.0",
  "identifier": "TwitchLiveAlert.Desktop",
  "build": {},
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Twitch Live Alert",
    "externalBin": ["binaries/twitch-live-alert"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
